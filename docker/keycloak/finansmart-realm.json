{
  "realm": "finansmart",
  "displayName": "FinanSmart",
  "enabled": true,
  "loginTheme": "finansmart",
  "registrationAllowed": true,
  "rememberMe": true,
  "resetPasswordAllowed": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["pt-BR"],
  "defaultLocale": "pt-BR",
  "clients": [
    {
      "clientId": "finansmart-web",
      "name": "FinanSmart Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      }
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid email profile"
      }
    }
  ],
  "users": [
    {
      "id": "7d9f3c1e-5a2b-4e8f-9c6d-1b2a3c4d5e6f",
      "username": "demo",
      "enabled": true,
      "email": "demo@finansmart.local",
      "emailVerified": true,
      "firstName": "Usuario",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ]
    }
  ]
}
